# Copy to .env and fill in. Never commit .env.

# --- LLM ---------------------------------------------------------------
# One of: gemini | groq | anthropic | mock   (mock = deterministic offline stub, for tests)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
ANTHROPIC_API_KEY=your-anthropic-key

# --- Database ----------------------------------------------------------
# Postgres URL (Neon / Supabase). Leave empty to use a local SQLite file.
DATABASE_URL=
SQLITE_PATH=data/prompts.db

# --- Behaviour ---------------------------------------------------------
# Order of chatHistory in requests. The assignment example lists the NEWEST message first.
HISTORY_ORDER=newest_first
# Number of similar real exchanges injected as few-shot examples (0 disables).
FEWSHOT_K=3
# Re-generate after an auto-edit and reject the edit if it scores worse (costs 1 extra LLM call).
VALIDATE_EDITS=false
# If set, /improve-ai and /improve-ai-manually require header "X-Admin-Token: <value>".
ADMIN_TOKEN=
